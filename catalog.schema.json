{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.sleepynoises.com/catalog.schema.json",
  "title": "Sleepy Noises catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updatedAt",
    "categories",
    "podcasts"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "podcasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "feedUrl",
          "categoryId"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "feedUrl": {
            "$ref": "#/$defs/megaphoneFeed"
          },
          "categoryId": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "artworkUrl": {
            "$ref": "#/$defs/httpsUrl"
          },
          "featured": {
            "type": "boolean"
          }
        }
      }
    },
    "retired": {
      "type": "array",
      "description": "Ids of shows taken out for good. The app deletes a show (with the listener's likes, progress and downloads for it) only when its id is listed here, never because it is missing from podcasts. Once listed, an id stays listed and is never used again.",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "httpsUrl": {
      "type": "string",
      "description": "Artwork must be on a host the app trusts (Megaphone's, or this site), or the app rejects the whole catalog.",
      "pattern": "^https://([A-Za-z0-9-]+\\.)*(megaphone\\.fm|megaphone\\.cloud|megaphone\\.imgix\\.net|listen\\.sleepynoises\\.com)(/[^\\s]*)?$",
      "maxLength": 2048
    },
    "megaphoneFeed": {
      "type": "string",
      "pattern": "^https://feeds\\.megaphone\\.fm/[A-Za-z0-9_-]+$"
    }
  }
}
