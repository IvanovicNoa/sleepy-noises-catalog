{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listen.sleepynoises.com/catalog.schema.json",
  "title": "Sleepy Noises catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updatedAt",
    "categories",
    "podcasts"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "sortOrder": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "podcasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "feedUrl",
          "categoryId"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "feedUrl": {
            "$ref": "#/$defs/megaphoneFeed"
          },
          "categoryId": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "artworkUrl": {
            "$ref": "#/$defs/httpsUrl"
          },
          "featured": {
            "type": "boolean"
          },
          "premiumFeedUrl": {
            "$ref": "#/$defs/megaphoneFeed"
          }
        }
      }
    },
    "minAppVersion": {
      "description": "Phones running an older app version than this, per store, are asked to update. Set a store's value only once the fixed version is live in that store. Leave it afterwards: it never affects newer versions.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ios": {
          "$ref": "#/$defs/appVersion"
        },
        "android": {
          "$ref": "#/$defs/appVersion"
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "httpsUrl": {
      "type": "string",
      "description": "Artwork must be on a host the app trusts, or the app rejects the whole catalog.",
      "pattern": "^https://([A-Za-z0-9-]+\\.)*(megaphone\\.fm|megaphone\\.cloud|megaphone\\.imgix\\.net|ivanovicnoa\\.github\\.io)(/[^\\s]*)?$",
      "maxLength": 2048
    },
    "megaphoneFeed": {
      "type": "string",
      "pattern": "^https://feeds\\.megaphone\\.fm/[A-Za-z0-9_-]+$"
    },
    "appVersion": {
      "type": "string",
      "description": "MAJOR.MINOR.PATCH: the app's pubspec.yaml version without its +build number, e.g. 1.2.1.",
      "pattern": "^(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3})$"
    }
  }
}
